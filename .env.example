# ANIME STRIKERS — copie para .env e ajuste. NUNCA faça commit do .env.

# ── Servidor ────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Origem(ns) permitidas no CORS, separadas por vírgula (a URL do cliente).
CLIENT_ORIGIN=http://localhost:5173
# Segredo (>= 16 caracteres) que assina os tokens de convidado. OBRIGATÓRIO em produção.
# Gere um valor aleatório, por exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-com-32-ou-mais-caracteres

# ── Banco de dados (PostgreSQL) ─────────────────────────────
# Mesmos dados do docker-compose.yml. Sem DATABASE_URL o servidor usa memória (nada é salvo ao reiniciar).
DATABASE_URL=postgresql://strikers:strikers@localhost:5432/anime_strikers?schema=public

# ── Produção (opcional) ─────────────────────────────────────
# Pasta do build do cliente para o servidor servir tudo em uma única porta.
# CLIENT_DIST=./apps/client/dist

# ── Ritmo do jogo (opcional, em ms). Omitido = regras oficiais ─
# GAME_AUCTION_MS=15000
# GAME_INTERMISSION_MS=3000
# GAME_FIRST_DELAY_MS=3000
# GAME_SNIPE_WINDOW_MS=3000
# GAME_SNIPE_EXTENSION_MS=5000
# GAME_BOT_DELAY_SCALE=1

# ── Cliente (Vite) ──────────────────────────────────────────
# Só necessário se o servidor estiver em outra origem. Em dev o proxy do Vite cuida disso.
# VITE_SERVER_URL=http://localhost:3001
