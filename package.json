{
  "name": "anime-strikers",
  "version": "0.1.0",
  "private": true,
  "description": "ANIME STRIKERS - fan game não oficial de futebol com leilão de personagens de anime.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w @strikers/server\" \"npm run dev -w @strikers/client\"",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @strikers/client",
    "db:generate": "npm run db:generate -w @strikers/server",
    "db:migrate": "npm run db:migrate -w @strikers/server",
    "db:seed": "npm run db:seed -w @strikers/server",
    "demo:multiplayer": "npm run demo:multiplayer -w @strikers/server",
    "postinstall": "npm run db:generate -w @strikers/server",
    "test:db": "npm run test:db -w @strikers/server"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "embedded-postgres": "^17.5.0-beta.15",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
